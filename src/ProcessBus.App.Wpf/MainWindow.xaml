                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Show repeated messages"
                                               Foreground="#D9ECFF"
                                               FontSize="12"
                                               FontWeight="Medium"/>
                                    <TextBlock Text="{Binding GooseRetransmissionModeText}"
                                               Foreground="#7FA8CC"
                                               FontSize="10.5"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <ToggleButton Grid.Row="0" Grid.Column="1"
                                              Width="48"
                                              Height="24"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IncludeGooseRetransmission, Mode=TwoWay}"
                                              FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Track"
                                                    CornerRadius="12"
                                                    Background="#102236"
                                                    BorderBrush="#244B6D"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Ellipse x:Name="Knob"
                                                             Width="18"
                                                             Height="18"
                                                             HorizontalAlignment="Left"
                                                             Margin="3,0,0,0"
                                                             Fill="#7FA8CC"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Track" Property="Background" Value="#0A5FB8"/>
                                                    <Setter TargetName="Track" Property="BorderBrush" Value="#1B8CFF"/>
                                                    <Setter TargetName="Knob" Property="Fill" Value="#F4FAFF"/>
                                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                    <TextBlock Text="Message name"
                                               Foreground="#7FA8CC"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <ComboBox Style="{StaticResource CompactComboBoxStyle}"
                                              ItemsSource="{Binding GooseIdFilterOptions}"
                                              SelectedItem="{Binding SelectedGooseIdFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="3">
                                <TextBlock Text="Sending devices"
                                           Foreground="#7FA8CC"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <ListView ItemsSource="{Binding GoosePublisherRowsView}"
                                          SelectedItem="{Binding SelectedGoosePublisherRow, Mode=TwoWay}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <!-- Re-clicking the already selected publisher must exit pinned-event mode. -->
                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="GoosePublisherRow_PreviewMouseLeftButtonDown"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="Card"
                                                                Padding="10,9"
                                                                Background="#071827"
                                                                BorderBrush="#16324E"
                                                                BorderThickness="1"
                                                                CornerRadius="10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter Grid.Column="0"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="›"
                                                                           Foreground="#57B8FF"
                                                                           FontSize="18"
                                                                           VerticalAlignment="Center"
                                                                           Margin="8,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Card" Property="Background" Value="#0B3C68"/>
                                                                <Setter TargetName="Card" Property="BorderBrush" Value="#1387DF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Card" Property="BorderBrush" Value="#286592"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding GoId}"
                                                               Foreground="#F4FAFF" FontSize="12.5"
                                                               FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding GoId}"/>
                                                    <Border Grid.Column="1" Padding="5,1"
                                                            CornerRadius="4" Margin="5,0,0,0"
                                                            Background="#3B2C18" BorderBrush="#70552C"
                                                            BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTest}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="TEST" FontSize="9"
                                                                   Foreground="#F0C681" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding GoCbRef}"
                                                           Foreground="#8FAAC3"
                                                           FontSize="10.5"
                                                           Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Margin="0,5,0,0"
                                                           Foreground="#57B8FF"
                                                           FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}App {0} · State {1} · Seq {2}">
                                                            <Binding Path="AppId"/>
                                                            <Binding Path="StNum"/>
                                                            <Binding Path="SqNum"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                            <Border Grid.Row="4"
                                    Padding="10,8"
                                    Background="#061522"
                                    BorderBrush="#132D46"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,10,0,0">
                                <TextBlock Text="{Binding GooseFilterSummaryText}"
                                           Foreground="#8FAAC3"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </Grid>

                        <!-- =========================================================
             TIMING / PTP LEFT EXPLORER
             ========================================================= -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="3">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Margin="0,1,8,0"
                                               Foreground="{StaticResource AccentStrongBrush}"
                                               Text="&#xE916;"/>
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                               Text="Timing Reference"/>
                                </StackPanel>
                                <TextBlock Margin="0,2,0,10"
                                           Style="{StaticResource PanelSubtitleTextStyle}"
                                           Text="Source and capture confidence"/>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource DenseMetricCardStyle}" Margin="{StaticResource WorkspacePanelGapBelow}">
                                <StackPanel>
                                    <TextBlock Text="PTP Status" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding PtpStatusText}" Foreground="#EAF6FF" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,5,0,0" Text="{Binding PtpTransportText}" Foreground="#8FAAC3" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource DenseMetricCardStyle}" Margin="{StaticResource WorkspacePanelGapBelow}">
                                <StackPanel>
                                    <TextBlock Text="Capture confidence" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding TimingConfidenceBadgeText}" Foreground="#F6D781"
                                               FontSize="13" FontWeight="SemiBold" ToolTip="{Binding TimingConfidenceText}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Style="{StaticResource DenseMetricCardStyle}">
    <Expander Header="Protocol details" IsExpanded="False" Foreground="#D7EAFB">
        <StackPanel Margin="0,8,0,0">
            <TextBlock Text="{Binding ProtocolSvStatusText}" Foreground="#B6CDE2" TextWrapping="Wrap"/>
            <TextBlock Margin="0,5,0,0" Text="{Binding ProtocolGooseStatusText}" Foreground="#B6CDE2" TextWrapping="Wrap"/>
            <TextBlock Margin="0,5,0,0" Text="{Binding ProtocolPtpStatusText}" Foreground="#B6CDE2" TextWrapping="Wrap"/>
            <TextBlock Margin="0,8,0,0" Text="{Binding TimingMetricText}" Foreground="#91B0C9" TextWrapping="Wrap"/>
            <TextBlock Margin="0,4,0,0" Text="{Binding AdapterTimingRiskText}" Foreground="#91B0C9" TextWrapping="Wrap"/>
        </StackPanel>
    </Expander>
</Border>
                        </Grid>

                        <!-- =========================================================
             SCL LEFT EXPLORER
             ========================================================= -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="5">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Margin="0,1,8,0"
                                               Foreground="{StaticResource AccentStrongBrush}"
                                               Text="&#xE8D4;"/>
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                               Text="SCL Explorer"/>
                                </StackPanel>
                                <TextBlock Margin="0,2,0,10"
                                           Style="{StaticResource PanelSubtitleTextStyle}"
                                           Text="Imported IEDs from SCL documents. Select one IED to filter the semantic stream catalog."/>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="{StaticResource WorkspacePanelGapBelow}"
                                    Style="{StaticResource CompactExplorerCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Project summary"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding SclWorkspaceSummaryText}"
                                               TextWrapping="Wrap"
                                               Foreground="#8FAAC3"
                                               FontSize="10.5"/>
                                </StackPanel>
                            </Border>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding SclIedCards}"
                                     SelectedItem="{Binding SelectedSclIedCard, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="SclDocumentCard"
                                                            Style="{StaticResource CompactExplorerCardStyle}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="SclDocumentCard" Property="Background" Value="#123E66"/>
                                                            <Setter TargetName="SclDocumentCard" Property="BorderBrush" Value="#1987E6"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SclDocumentCard" Property="BorderBrush" Value="#2F6F9D"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="#F3FAFF" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SummaryText}" Foreground="#CFE7FF" FontSize="10.6" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            <DockPanel Margin="0,4,0,0">
                                                <TextBlock Text="{Binding StatusText}" Foreground="#6AD59F" FontSize="9.8" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                                <TextBlock Text="{Binding SourceFileName}" Foreground="#91AFC8" FontSize="10.2" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Row="3"
                                       Text="Explorer selection drives the catalog and inspector."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10"/>
                        </Grid>

                        <!-- =========================================================
             VALIDATION LEFT SUMMARY
             ========================================================= -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="4">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Margin="0,1,8,0"
                                               Foreground="{StaticResource AccentStrongBrush}"
                                               Text="&#xE9D9;"/>
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                               Text="Validation Summary"/>
                                </StackPanel>

                                <TextBlock Margin="0,2,0,10"
                                           Style="{StaticResource PanelSubtitleTextStyle}"
                                           Text="Decision layer from SCL binding and live traffic"/>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="0,0,0,10"
                                    Padding="12"
                                    Background="{Binding ValidationOverallBackgroundBrush}"
                                    BorderBrush="{Binding ValidationOverallBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding ValidationOverallStatusText}"
                                               Foreground="{Binding ValidationOverallBrush}"
                                               FontSize="22"
                                               FontWeight="Bold"/>
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding ValidationSummaryCompactText}"
                                               TextWrapping="Wrap"
                                               Foreground="#D6E8F8"
                                               FontSize="11.5"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="2">
                                <Border Style="{StaticResource DenseMetricCardStyle}" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="SV" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,5,0,0" Text="{Binding ValidationSvSummaryText}" TextWrapping="Wrap" Style="{StaticResource CompactValueTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DenseMetricCardStyle}" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="GOOSE" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,5,0,0" Text="{Binding ValidationGooseSummaryText}" TextWrapping="Wrap" Style="{StaticResource CompactValueTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DenseMetricCardStyle}" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="PTP / Timing" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,5,0,0" Text="{Binding ValidationPtpSummaryText}" TextWrapping="Wrap" Style="{StaticResource CompactValueTextStyle}"/>
                                        <TextBlock Margin="0,5,0,0" Text="{Binding ValidationTimingCompactText}" TextWrapping="Wrap" Foreground="#F6D781" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Row="3"
                                       Text="Detailed evidence remains in the main grid and SCL inspector."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10"/>
                        </Grid>

                        <!-- =========================================================
             FRAME VIEWER LEFT EXPLORER
             ========================================================= -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="6">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Margin="0,1,8,0"
                               Foreground="{StaticResource AccentStrongBrush}"
                               Text="&#xE713;"/>
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                               Text="Advanced Tools"/>
                                </StackPanel>

                                <TextBlock Margin="0,2,0,10"
                           Style="{StaticResource PanelSubtitleTextStyle}"
                           Text="Forensic target inspector"/>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="0,0,0,10"
                                    Style="{StaticResource CompactExplorerCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="SCL Semantic Mapping"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Margin="0,4,0,8"
                                               Text="{Binding SclSummaryText}"
                                               TextWrapping="Wrap"
                                               Foreground="#8FAAC3"
                                               FontSize="10.5"/>
                                    <WrapPanel>
                                        <Button Command="{Binding LoadSclCommand}"
                                                Style="{StaticResource ToolbarGhostButtonStyle}"
                                                MinWidth="72"
                                                Padding="10,5">
                                            <TextBlock Text="Load SCL" FontWeight="SemiBold"/>
                                        </Button>
                                        <Button Command="{Binding ClearSclCommand}"
                                                Style="{StaticResource ToolbarMutedButtonStyle}"
                                                MinWidth="56"
                                                Padding="10,5"
                                                Margin="6,0,0,0">
                                            <TextBlock Text="Clear" FontWeight="SemiBold"/>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock Margin="0,7,0,0"
                                               Text="{Binding SclLoadStatusText}"
                                               TextWrapping="Wrap"
                                               Foreground="#6F8FAF"
                                               FontSize="10"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource CompactExplorerCardStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Raw Target Explorer"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Select SV, GOOSE, or PTP source. Details stay locked while live data updates."
                                                   TextWrapping="Wrap"
                                                   Foreground="#8FAAC3"
                                                   FontSize="10.5"/>
                                    </StackPanel>
                                </Border>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding DiagnosticTargets}"
                                         SelectedItem="{Binding SelectedDiagnosticTarget, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="AdvancedTargetCard"
                                                                Style="{StaticResource CompactExplorerCardStyle}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="AdvancedTargetCard" Property="Background" Value="#123E66"/>
                                                                <Setter TargetName="AdvancedTargetCard" Property="BorderBrush" Value="#1987E6"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="AdvancedTargetCard" Property="BorderBrush" Value="#2F6F9D"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="5" CornerRadius="3" Margin="0,1,8,1" Background="{Binding StatusBrush}"/>
                                                <StackPanel Grid.Column="1">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Protocol}" Foreground="#8FB8D8" FontSize="10" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#F3FAFF" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="#91AFC8" FontSize="10.3" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding LastSeenText}" Foreground="#789AB8" FontSize="9.5" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <TextBlock Grid.Row="3"
                       Text="Advanced raw decode only."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="2"
            Grid.ColumnSpan="3"
            Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TabControl x:Name="WorkspaceTabs"
                        Grid.Row="0"
                                SelectedIndex="{Binding CurrentWorkspaceTabIndex, Mode=TwoWay}"
                                SelectionChanged="WorkspaceTabs_SelectionChanged"
                            Style="{StaticResource AnalyzerTabControlStyle}">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TabControl.Resources>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" Foreground="#EAF6FF" Text="&#xE9D9;"/>
                                    <TextBlock Text="Analyzer" Foreground="#EAF6FF" FontWeight="SemiBold"/>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="320"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0"/>
                                    <RowDefinition Height="0"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="ScopeHeroPanel"
            Grid.Column="0"
            Grid.Row="2"
            Style="{StaticResource DenseGroupBorderStyle}"
            BorderBrush="#0D8CFF"
            BorderThickness="1.2"
            Background="#0B2035">
