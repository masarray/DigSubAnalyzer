                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="Foreground" Value="#91AAC2"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTemplateColumn Header="What happened" Width="118">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="8,3"
                                                                    Background="#13202D"
                                                                    BorderBrush="#273A4E"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
