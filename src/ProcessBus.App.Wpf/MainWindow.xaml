                                            CornerRadius="9" Padding="12,10" Margin="0,0,8,0"
                                            ToolTip="Discontinuous smpCnt transitions for the selected SV stream. Not the number of missing samples.">
                                        <StackPanel>
                                            <TextBlock Text="SMP COUNT JUMPS" Foreground="#9BC7E4" FontSize="10.5"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Diagnostics.SvSequenceJumpsText}"
