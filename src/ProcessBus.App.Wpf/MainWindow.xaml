                                                <TextBlock Text="{Binding EvidencePtpText}"
                                                           Foreground="#D6E8F8"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding TimingConfidenceText}"
                                                           Foreground="#8FAAC3"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel>
                                                <TextBlock Text="{Binding EvidenceDecodeText}"
                                                           Foreground="#D6E8F8"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding EvidenceCapturePathText}"
                                                           Foreground="#8FAAC3"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"
