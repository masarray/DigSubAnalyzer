                        </Grid>
                    </Border>

             <!-- =========================================================
             ROW 2 — QUIET STATUS STRIP
             ========================================================= -->
                    <Border Grid.Row="2"
                            MinHeight="32"
                            Padding="14,7"
                            Background="#07111D"
                            CornerRadius="0,0,8,8">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#A8CDEB"
                                       Text="{Binding OperatorCaptureSummaryText}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
                        <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Locked workspace layout: left explorer / main canvas / right inspector -->
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="8"/>
                    <!-- GAP -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <!-- GAP -->
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0"
        Grid.Row="0"
        Style="{StaticResource DenseGroupBorderStyle}"
        Background="{StaticResource PanelDeepBrush}">

                    <Grid>

                        <!-- =========================================================
             ANALYZER LEFT EXPLORER — SV STREAMS
             ========================================================= -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Margin="0,1,8,0"
                               Foreground="{StaticResource AccentStrongBrush}"
                               Text="&#xE8F1;"/>
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                               Text="SV Streams"/>
                                </StackPanel>

                                </StackPanel>

                            <TextBox Grid.Row="1"
                     Margin="0,6,0,6"
                     Style="{StaticResource CompactSearchBoxStyle}"
                     Text="Filter stream name or svID"
                     Visibility="Collapsed"
                     IsEnabled="False"/>

                            <ListView Grid.Row="2"
                                      Style="{StaticResource GridListViewStyle}"
                                      ItemsSource="{Binding Streams}"
                                      Margin="0,10,0,0"
                                      SelectedItem="{Binding SelectedStream, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ClipToBounds="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <ListView.ItemContainerStyle>
                                    <!-- SV selector: visually matched with top Blue Pill navbar. -->
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Setter.Value>
                                        </Setter>
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SvPill_MouseDown"/>
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SvPill_MouseUp"/>
                                        <EventSetter Event="MouseLeave" Handler="SvPill_MouseLeave"/>
                                        <Setter Property="Foreground" Value="#B8C8D9"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Grid x:Name="Root"
                                                          Height="40"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          SnapsToDevicePixels="True"
                                                          ClipToBounds="False">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </Grid.RenderTransform>

                                                        <!-- Selected surface copied from the top workspace navbar. -->
                                                        <Border x:Name="SelectedPill"
                                                                CornerRadius="20"
                                                                Opacity="0"
                                                                RenderTransformOrigin="0.5,0.5">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#1189FF" Offset="0"/>
                                                                    <GradientStop Color="#0A5FB8" Offset="0.55"/>
                                                                    <GradientStop Color="#073A7A" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#1B8CFF" BlurRadius="16" ShadowDepth="0" Opacity="0.42"/>
                                                            </Border.Effect>
                                                        </Border>

                                                        <!-- Hover glass layer copied from navbar behaviour. -->
                                                        <Border x:Name="HoverPill"
                                                                CornerRadius="20"
                                                                Background="#172638"
                                                                Opacity="0"/>

                                                        <ContentPresenter Margin="10,0"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center"
                                                                          RecognizesAccessKey="True"
                                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                    </Grid>

                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="HoverPill" Property="Opacity" Value="0.72"/>
                                                            <Setter Property="Foreground" Value="#F2FAFF"/>
                                                            <Setter TargetName="Root" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="1.018" ScaleY="1.018"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>

                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="SelectedPill" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="HoverPill" Property="Opacity" Value="0"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>

                                        <Style.Triggers>
                                            <EventTrigger RoutedEvent="ListViewItem.Selected">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.82" To="1"
                                                                         Duration="0:0:0.16"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Compact content so the SV selector feels like a nav segment, not a card. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Margin="0,0,9,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrush}"/>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StreamName}"
                                                           FontSize="11.7"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Margin="0,1,0,0"
                                                           FontSize="9.6"
                                                           Foreground="#7FA8CC"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="APPID {0}  -  {1:HH:mm:ss.fff}">
                                                            <Binding Path="AppId"/>
                                                            <Binding Path="LastSeenUtc"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Padding="5,1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="9"
                                                    Background="{Binding StatusSoftBrush}"
                                                    ToolTip="{Binding IssueSummaryText}">
                                                <TextBlock FontSize="8.8"
                                                           FontWeight="Bold"
                                                           Text="{Binding DisplayStatusText}"
                                                           Foreground="{Binding StatusBrush}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Expander Grid.Row="3"
                      Style="{StaticResource DenseExpanderStyle}"
                      Header="Stream details"
                      IsExpanded="False">
                                <Border Margin="0,6,0,0"
                        Padding="8"
                        Background="#0B1A2A"
                        BorderBrush="#1B344F"
                        BorderThickness="1"
                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedStreamDetails.SvId, StringFormat=svID: {0}}"
                                                   Foreground="#D6E8F8" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Margin="0,3,0,0" Text="{Binding SelectedStreamDetails.AppId, StringFormat=APPID: {0}}"
                                                   Foreground="#9FB8D2"/>
                                        <TextBlock Margin="0,3,0,5" Text="{Binding SelectedStreamDetails.ConfRevText, StringFormat=confRev: {0}}"
                                                   Foreground="#9FB8D2"/>
                                        <TextBlock Style="{StaticResource CompactLabelTextStyle}"
                                   Text="Mapped channels"/>
                                        <TextBlock Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CompactValueTextStyle}"
                                   Text="{Binding SelectedStreamDetails.MappedChannelNamesText}"/>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </Grid>

                        <!-- =========================================================
             DIAGNOSTICS LEFT EXPLORER — target-aware traffic health navigator
             ========================================================= -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Margin="0,1,8,0"
                                               Foreground="{StaticResource AccentStrongBrush}"
                                               Text="&#xE9D2;"/>
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                               Text="Traffic Health"/>
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource PanelSubtitleTextStyle}"
                                           Text="Select a source to inspect"/>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Style="{StaticResource DenseMetricCardStyle}"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="All sources"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding DiagnosticAffectedSummaryText}"
                                               TextWrapping="Wrap"
                                               Foreground="#8FB8D8"
                                               FontSize="10.5"/>
                                </StackPanel>
