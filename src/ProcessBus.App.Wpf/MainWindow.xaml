                                                                       Foreground="#F4FAFF"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding GoCbRef}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="State / sequence" Width="120">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#DDEEFF">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0} / {1}">
                                                                        <Binding Path="StNum"/>
                                                                        <Binding Path="SqNum"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Value changes" Width="1.3*" MinWidth="135">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayValuesText}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#D9ECFF"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <!-- Plain, useful empty-state rather than an inactive sea of cards.
                                             Bound to the filtered live view; no polling or extra VM cache. -->
                                        <Border Grid.Row="2" Background="#0B1B2B" CornerRadius="8" Padding="24"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GooseHistoryView.IsEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        MaxWidth="390">
                                                <TextBlock Text="{Binding GooseEmptyTitle}"
                                                           Foreground="#E5F2FF" FontSize="15"
                                                           FontWeight="SemiBold" TextAlignment="Center"/>
                                                <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="#A6C4DB" FontSize="11.5"
                                                           Text="{Binding GooseEmptyGuidance}"
                                                           ToolTip="An empty state-change view does not prove the publisher is offline. Confirm the adapter, SPAN/TAP path, VLAN and goID filters."/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Right inspector: clean grouped information, typed values emphasized. -->
                                <Border Grid.Column="2"
                                        Style="{StaticResource DenseGroupBorderStyle}"
                                        Padding="{StaticResource WorkspacePanelInset}">
                                    <!-- Keep operator context and Return to Live visible while
                                         the evidence below scrolls. No nested scrolling. -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Message Details" Foreground="#F4FAFF"
                                                                   FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <Border Padding="7,2" Margin="8,0,0,0" CornerRadius="4"
                                                                Background="#143149" BorderBrush="#2B5973"
                                                                BorderThickness="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding GooseInspectorModeBadgeText}"
                                                                       Foreground="#9EDBFF" FontSize="9.5" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Padding="7,2" Margin="6,0,0,0" CornerRadius="4"
                                                                Background="#392C17" BorderBrush="#6F562B"
                                                                BorderThickness="1" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding GooseInspectorMessage.IsTest}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="TEST" FontSize="9.5" FontWeight="SemiBold"
                                                                       Foreground="#F1CA85"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding GooseInspectorModeText}" Foreground="#91B6D2"
                                                               FontSize="11" Margin="0,5,8,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Show Latest"
                                                        Command="{Binding GooseReturnToLiveCommand}" VerticalAlignment="Top"
                                                        Padding="9,5" FontSize="10.5" FontWeight="Medium"
                                                        Foreground="#B9E3FF" Background="#102E49"
                                                        BorderBrush="#24587D" BorderThickness="1" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGooseHistoryPinned}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        <ScrollViewer Grid.Row="1"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Focusable="False">
                                            <StackPanel>
                                                <TextBlock Text="Choose a sending device or recorded message to inspect its values."
                                                       Foreground="#9FC0DA" FontSize="11.5" TextWrapping="Wrap"
                                                       Margin="0,12,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GooseInspectorMessage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Border Padding="12"
                                                    Background="#0B1C2D"
                                                    BorderBrush="#1A3852"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Margin="0,0,0,12">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GooseInspectorMessage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="112"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Message name" ToolTip="Original GOOSE ID (goID) field" Foreground="#7FA8CC" FontSize="11" Margin="0,3,10,3"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GooseInspectorMessage.GoId}" Foreground="#F4FAFF" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,3"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Control block" ToolTip="Sending control block reference (goCbRef)" Foreground="#7FA8CC" FontSize="11" Margin="0,3,10,3"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GooseInspectorMessage.GoCbRef}" Foreground="#DDEEFF" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Application code" ToolTip="APPID field: identifies this GOOSE message group" Foreground="#7FA8CC" FontSize="11" Margin="0,3,10,3"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GooseInspectorMessage.AppId}" Foreground="#DDEEFF" Margin="0,3,0,3"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="State number"
                                                               ToolTip="State number (stNum): increments when publisher state changes"
                                                               Foreground="#7FA8CC" FontSize="11" Margin="0,3,10,3"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GooseInspectorMessage.StNum}"
                                                               Foreground="#DDEEFF" FontWeight="SemiBold" Margin="0,3,0,3"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Sequence number"
                                                               ToolTip="Sequence number (sqNum): identifies repetitions within a state"
                                                               Foreground="#7FA8CC" FontSize="11" Margin="0,3,10,3"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GooseInspectorMessage.SqNum}"
                                                               Foreground="#DDEEFF" FontWeight="SemiBold" Margin="0,3,0,3"/>
                                                </Grid>
                                            </Border>

                                            <Border Padding="12"
                                                    Background="#0B1C2D"
                                                    BorderBrush="#1A3852"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Margin="0,0,0,12">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GooseInspectorMessage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="Network Information"
                                                               Foreground="#F4FAFF"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,0,9"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="112"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sender address" ToolTip="Original Ethernet source MAC address" Foreground="#7FA8CC" FontSize="11" Margin="0,3,10,3"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GooseInspectorMessage.SourceMac}" Foreground="#DDEEFF" Margin="0,3,0,3"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Group address" ToolTip="Destination Ethernet multicast MAC address" Foreground="#7FA8CC" FontSize="11" Margin="0,3,10,3"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GooseInspectorMessage.DestinationMac}" Foreground="#DDEEFF" Margin="0,3,0,3"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Network group" ToolTip="VLAN ID and network priority" Foreground="#7FA8CC" FontSize="11" Margin="0,3,10,3"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Foreground="#DDEEFF" Margin="0,3,0,3">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}ID {0} · Priority {1}">
                                                                    <Binding Path="GooseInspectorMessage.VlanId"/>
                                                                    <Binding Path="GooseInspectorMessage.VlanPriority"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Published data" ToolTip="Full DataSet reference identifying the group of transmitted values" Foreground="#7FA8CC" FontSize="11" Margin="0,3,10,3"/>
                                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GooseInspectorMessage.DataSet}" Foreground="#DDEEFF" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Config. version" ToolTip="Configuration revision (confRev)" Foreground="#7FA8CC" FontSize="11" Margin="0,3,10,3"/>
                                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GooseInspectorMessage.ConfRev}" Foreground="#DDEEFF" Margin="0,3,0,3"/>
                                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Allowed wait" ToolTip="Time allowed to live in milliseconds: how long a receiver can wait for another message" Foreground="#7FA8CC" FontSize="11" Margin="0,3,10,3"/>
                                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding GooseInspectorMessage.TimeAllowedToLiveMilliseconds, StringFormat={}{0} ms}" Foreground="#DDEEFF" Margin="0,3,0,3"/>
                                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Message flags" Foreground="#7FA8CC" FontSize="11" Margin="0,3,10,3"/>
                                                        <TextBlock Grid.Row="6" Grid.Column="1" Foreground="#DDEEFF" Margin="0,3,0,3">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}Test message: {0} · Needs commissioning: {1}">
                                                                    <Binding Path="GooseInspectorMessage.IsTest"/>
                                                                    <Binding Path="GooseInspectorMessage.NeedsCommission"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Padding="12"
                                                    Background="#0B1C2D"
                                                    BorderBrush="#1A3852"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GooseInspectorMessage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <!-- Explicit grid prevents DockPanel's LastChildFill
                                                         from collapsing the title/count separation. -->
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Published Values"
                                                                   Foreground="#F4FAFF" FontSize="13.5"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                                   Text="{Binding GooseInspectorDatasetCountText, StringFormat={}{0} items}"
                                                                   Foreground="#F0C17F" FontSize="11"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding SelectedGooseSemanticText}"
                                                               Foreground="#A1BED4"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,5"/>
                                                    <Button Content="Identify these signals in the Configuration tab"
                                                            Command="{Binding GooseOpenConfigurationCommand}"
                                                            Foreground="#81C9F7"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Left"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="0,1"
                                                            FontSize="10.5"
                                                            Cursor="Hand"
                                                            Margin="0,0,0,7">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding GooseSignalNamesUnavailable}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Name/value pairs keep raw typed data readable even without SCL.
                                                         Expanded rows reveal protocol evidence and verified quality. -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="160"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="SIGNAL OR DATA ITEM" FontSize="10"
                                                                   Foreground="#7D9DB6" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="RECEIVED VALUE" FontSize="10"
                                                                   Foreground="#7D9DB6" FontWeight="SemiBold"
                                                                   TextAlignment="Right" Margin="0,0,8,0"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding GooseInspectorRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Expander Style="{StaticResource GooseDatasetExpanderStyle}"
                                                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                          Margin="0,0,0,2" ToolTip="{Binding NameText}">
                                                                    <Expander.Header>
                                                                        <Grid MinHeight="38" HorizontalAlignment="Stretch">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="25"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="154"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding IndexText}"
                                                                                       Foreground="#7699B9" FontSize="10.5"
                                                                                       VerticalAlignment="Center"/>
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                                                        Margin="0,0,7,0">
                                                                                <TextBlock Text="{Binding NameText}" FontSize="11.5"
                                                                                           Foreground="#EAF6FF" FontWeight="Medium"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Text="{Binding TypeText}" FontSize="10"
                                                                                           Foreground="#7E9FB9" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DisplayValueText}"
                                                                                           FontFamily="Consolas, Segoe UI"
                                                                                           Foreground="{Binding ValueBrush}" FontSize="11.5"
                                                                                           TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                                                                           ToolTip="{Binding DisplayValueText}"/>
                                                                                <TextBlock Text="{Binding ChangeText}"
                                                                                           Visibility="{Binding ChangeVisibility}"
                                                                                           FontSize="9.5" Foreground="#F2C477"
                                                                                           TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Expander.Header>
                                                                    <!-- Compact key/value evidence: full technical
                                                                         values remain selectable via their text and
                                                                         a stable expandable DataSet row. -->
                                                                    <Border Padding="10,7,10,9" Background="#081827"
                                                                            BorderBrush="#17354B" BorderThickness="0,1,0,0">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="85"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>
                                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Signal / item"
                                                                                       Foreground="#779EB9" FontSize="10.5" Margin="0,2,8,2"/>
                                                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NameText}"
                                                                                       Foreground="#E7F3FF" FontSize="11" TextWrapping="Wrap"
                                                                                       Margin="0,2,0,2" ToolTip="{Binding NameText}"/>
                                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Value kind"
                                                                                       Foreground="#779EB9" FontSize="10.5" Margin="0,2,8,2"/>
                                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TypeText}"
                                                                                       Foreground="#B9D3E8" FontSize="10.5" TextWrapping="Wrap"
                                                                                       Margin="0,2,0,2"/>
                                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Received value"
                                                                                       Foreground="#779EB9" FontSize="10.5" Margin="0,2,8,2"/>
                                                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ValueText}"
                                                                                       Foreground="#E7F3FF" FontSize="11" FontFamily="Consolas"
                                                                                       TextWrapping="Wrap" Margin="0,2,0,2"/>
                                                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Original bytes" ToolTip="Hexadecimal representation of the captured MMS data"
                                                                                       Foreground="#779EB9" FontSize="10.5" Margin="0,2,8,2"/>
                                                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RawHexDisplayText}"
                                                                                       Foreground="#C2D9E9" FontSize="11" FontFamily="Consolas"
                                                                                       TextWrapping="Wrap" Margin="0,2,0,2"/>
                                                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Wire format"
                                                                                       ToolTip="Original MMS data type before interpretation"
                                                                                       Foreground="#779EB9" FontSize="10.5" Margin="0,2,8,2"/>
                                                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProtocolTypeText}"
                                                                                       Foreground="#9ABBD3" FontSize="10.5" Margin="0,2,0,2"/>
                                                                            <TextBlock Grid.Row="5" Grid.ColumnSpan="2"
                                                                                       Margin="0,3,0,0" Text="{Binding ConfigurationTypeText}"
                                                                                       Visibility="{Binding ConfigurationTypeVisibility}"
                                                                                       ToolTip="Exact function, data class and wire type from the imported device configuration"
                                                                                       Foreground="#93B7D1" FontSize="10.5"
                                                                                       TextWrapping="Wrap"/>
                                                                            <TextBlock Grid.Row="6" Grid.ColumnSpan="2"
                                                                                       Margin="0,5,0,0" Text="{Binding QualityDetailsText}"
                                                                                       Visibility="{Binding QualityDetailsVisibility}"
                                                                                       Foreground="#9ED9E9" FontSize="10.5"
                                                                                       TextWrapping="Wrap"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </Expander>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" Foreground="#EAF6FF" Text="&#xE916;"/>
                                    <TextBlock Text="Timing / PTP" Foreground="#EAF6FF" FontWeight="SemiBold"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource DenseGroupBorderStyle}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#0E2539" BorderThickness="0" CornerRadius="8" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="PTP Reference" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Margin="0,6,0,0" Text="{Binding PtpStatusText}" Foreground="#F4FAFF" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Margin="0,5,0,0" Text="{Binding PtpDomainText}" Foreground="#8FAAC3" FontSize="11" ToolTip="{Binding PtpTransportText}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#0E2539" BorderThickness="0" CornerRadius="8" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="Grandmaster" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Margin="0,6,0,0" Text="{Binding PtpGrandmasterText}" Foreground="#F4FAFF" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Margin="0,6,0,0" Text="{Binding PtpDomainText}" Foreground="#8FAAC3"/>
                                                <TextBlock Margin="0,4,0,0" Text="{Binding PtpClockQualityText}" Foreground="#8FAAC3"
                                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="4" Background="#0E2539" BorderThickness="0" CornerRadius="8" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="PTP traffic" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Margin="0,6,0,0" Text="{Binding PtpRateText}" Foreground="#F4FAFF" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Margin="0,5,0,0" Text="{Binding PtpTwoStepEvidenceText}" Foreground="#8FAAC3" FontSize="11" TextWrapping="Wrap"/>
                                                
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource DenseGroupBorderStyle}" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Timing evidence" Style="{StaticResource PanelTitleTextStyle}" Margin="0,0,0,12"/>
                                            

                                            <Border Background="#0E2539" BorderThickness="0" CornerRadius="8" Padding="12" Margin="{StaticResource WorkspacePanelGapBelow}">
                                                <StackPanel>
                                                    <TextBlock Text="Assessment" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Margin="0,7,0,0" Text="{Binding TimingConfidenceBadgeText}"
                                                               ToolTip="{Binding TimingConfidenceText}"
                                                               Foreground="#F6D781" FontSize="17" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#0E2539" BorderThickness="0" CornerRadius="8" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="Timestamp" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Margin="0,7,0,0" Text="{Binding TimestampSourceText}" Foreground="#EAF6FF" TextWrapping="Wrap"/>
                                                    
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource DenseGroupBorderStyle}" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="SV arrival &amp; continuity" Style="{StaticResource PanelTitleTextStyle}" Margin="0,0,0,12"/>
                                            

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="#0E2539" BorderThickness="0" CornerRadius="8" Padding="12">
                                                    <StackPanel>
                                                        <TextBlock Text="Arrival Variation" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Margin="0,7,0,0" Text="{Binding JitterText}" Foreground="#F4FAFF" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Margin="0,5,0,0" Text="{Binding LatencyText}" Foreground="#8FAAC3"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="2" Background="#0E2539" BorderThickness="0" CornerRadius="8" Padding="12">
                                                    <StackPanel>
                                                        <TextBlock Text="Sequence / Loss" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Margin="0,7,0,0" Text="{Binding SequenceStatusText}" Foreground="#F4FAFF" FontSize="16" FontWeight="SemiBold"/>
                                                        <TextBlock Margin="0,5,0,0" Text="{Binding PacketLossText}" Foreground="#8FAAC3"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Secondary explanation is available on demand; the confidence
                                                 verdict is already shown in the primary left card. -->
                                            <Expander Margin="0,12,0,0" Header="Timing details"
                                                      IsExpanded="False" Foreground="#9CB9D2">
                                                <StackPanel Margin="6,6,6,0">
                                                    <TextBlock Text="{Binding TimingReferenceText}"
                                                               Foreground="#AFC9DD" FontSize="11"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Margin="0,6,0,0" Text="{Binding TimestampSourceText}"
                                                               Foreground="#9FB8D2" FontSize="11"
                                                               TextWrapping="Wrap"
                                                               ToolTip="{Binding TimingMetricText}"/>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="4" Style="{StaticResource DenseGroupBorderStyle}" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <TextBlock Text="PTP events" Style="{StaticResource PanelTitleTextStyle}" DockPanel.Dock="Left"/>
                                            
                                        </DockPanel>

                                        <DataGrid Grid.Row="2"
                                                  Style="{StaticResource DarkDataGridStyle}"
                                                  ItemsSource="{Binding PtpEvents}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserReorderColumns="False"
                                                  CanUserResizeRows="False"
                                                  CanUserSortColumns="False"
                                                  GridLinesVisibility="None"
                                                  RowHeight="30"
                                                  FontFamily="Segoe UI Variable Text, Segoe UI"
                                                  FontSize="11.5"
                                                  EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="True"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                      ScrollViewer.CanContentScroll="True"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="103"/>
                                                <DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="154"/>
                                                <DataGridTextColumn Header="Message" Binding="{Binding MessageType}" Width="100"/>
                                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="160"/>
                                                <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="160"/>
                                                <DataGridTextColumn Header="Domain" Binding="{Binding DomainText}" Width="63"/>
                                                <DataGridTextColumn Header="Seq" Binding="{Binding SequenceIdText}" Width="61"/>
                                                <DataGridTextColumn Header="Clock ID" Binding="{Binding ClockIdentity}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" Foreground="#EAF6FF" Text="&#xE9D9;"/>
                                    <TextBlock Text="Validation" Foreground="#EAF6FF" FontWeight="SemiBold"/>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource PremiumWorkspaceHeroStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                MinWidth="138"
                                                Padding="14,10"
                                                Background="{Binding ValidationOverallBackgroundBrush}"
                                                BorderBrush="{Binding ValidationOverallBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Text="Overall" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Margin="0,3,0,0" Text="{Binding ValidationOverallStatusText}" Foreground="{Binding ValidationOverallBrush}" FontSize="18" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Validation Dashboard" Style="{StaticResource PanelTitleTextStyle}"/>
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding ValidationSummaryCompactText}"
                                                       Style="{StaticResource PanelSubtitleTextStyle}"
                                                       TextWrapping="Wrap"/>
                                            
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="220">
                                            <TextBlock Text="{Binding ValidationPtpSummaryText}" Foreground="#D6E8F8" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,5,0,0" Text="{Binding ValidationTimingCompactText}" Foreground="#F6D781" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource PremiumInsightCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="SV Expected vs Observed" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Margin="0,5,0,0" Text="{Binding ValidationSvSummaryText}" Foreground="#F4FAFF" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource PremiumInsightCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="GOOSE Expected vs Observed" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Margin="0,5,0,0" Text="{Binding ValidationGooseSummaryText}" Foreground="#F4FAFF" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource PremiumInsightCardStyle}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Cancel"
                                                            Margin="5,0,0,0"
                                                            Padding="6,2"
                                                            Style="{StaticResource ToolbarGhostButtonStyle}"
                                                            Visibility="{Binding M4CancelVisibility}"
                                                            Command="{Binding CancelInspectPcapCommand}"
                                                            ToolTip="Stop offline inspection without changing the capture file."/>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Inspect PCAP"
                                                            Style="{StaticResource ToolbarGhostButtonStyle}"
                                                            Command="{Binding InspectPcapCommand}"
                                                            IsEnabled="{Binding CanInspectPcap}"
                                                            ToolTip="Read-only local capture screening. Load SCL first to compare canonical wire identity."/>
                                                    <TextBlock Text="Wire Evidence"
                                                               VerticalAlignment="Center"
                                                               Foreground="#8FB8D8"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                </DockPanel>
                                                <TextBlock Margin="0,5,0,0"
                                                           Text="{Binding M4CaptureSummaryText}"
                                                           ToolTip="{Binding M4CaptureDetailText}"
                                                           Foreground="#F4FAFF"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="42"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="2" Style="{StaticResource PremiumWorkspacePanelStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.35*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="0.9*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.ColumnSpan="3">
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="Validation Findings" Style="{StaticResource PanelTitleTextStyle}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <DataGrid Grid.Row="2"
                                                      Grid.Column="0"
                                                      Style="{StaticResource DarkDataGridStyle}"
                                                      ItemsSource="{Binding ValidationFindings}"
                                                      SelectedItem="{Binding SelectedValidationFindingRow, Mode=TwoWay}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      CanUserSortColumns="False"
                                                      GridLinesVisibility="None"
                                                      RowHeight="{x:Static sys:Double.NaN}"
                                                      MinRowHeight="64"
                                                      RowStyle="{StaticResource EngineeringDataGridRowStyle}"
                                                      CellStyle="{StaticResource EngineeringDataGridCellStyle}"
                                                      FontSize="11.5"
                                                      EnableRowVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      ScrollViewer.CanContentScroll="True"
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <DataGrid.Resources>
                                                    <Style x:Key="ValidationCellTextStyle" TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="TextTrimming" Value="None"/>
                                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                                        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                                                        <Setter Property="LineHeight" Value="16"/>
                                                    </Style>
                                                </DataGrid.Resources>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Status" Width="112">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding StatusBackgroundBrush}" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="10" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Object" Width="1.1*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding ObjectText}" Foreground="#F4FAFF" FontWeight="SemiBold" Style="{StaticResource ValidationCellTextStyle}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="IED / Scope" Width="0.85*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding IedName}" Foreground="#9FD8FF" FontWeight="SemiBold" Style="{StaticResource ValidationCellTextStyle}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Expected" Width="1.45*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding ExpectedText}" Foreground="#D6E8F8" Style="{StaticResource ValidationCellTextStyle}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Observed" Width="1.45*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding ObservedText}" Foreground="#F6D781" FontWeight="SemiBold" Style="{StaticResource ValidationCellTextStyle}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Evidence" Width="2.2*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding EvidenceText}" Foreground="#EAF6FF" Style="{StaticResource ValidationCellTextStyle}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <Border Grid.Row="2"
                                                    Grid.Column="2"
                                                    Style="{StaticResource PremiumInspectorPanelStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="12"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="12"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel>
                                                        <DockPanel LastChildFill="True">
                                                            <Border DockPanel.Dock="Right"
                                                                    Padding="8,3"
                                                                    Background="{Binding ValidationDetailStatusBackgroundBrush}"
                                                                    BorderBrush="{Binding ValidationDetailStatusBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10">
                                                                <TextBlock Text="{Binding SelectedValidationFindingRow.StatusText}"
                                                                           Foreground="{Binding ValidationDetailStatusBrush}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"/>
                                                            </Border>
                                                            <StackPanel>
                                                                <TextBlock Text="Selected Evidence" Style="{StaticResource PanelTitleTextStyle}"/>
                                                                <TextBlock Margin="0,4,0,0"
                                                                           Text="{Binding ValidationDetailTitle}"
                                                                           Foreground="#F4FAFF"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Margin="0,4,0,0"
                                                                           Text="{Binding ValidationDetailScopeText}"
                                                                           Foreground="#8FAAC3"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </StackPanel>

                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Style="{StaticResource PremiumSectionCardStyle}">
                                                            <StackPanel>
                                                                <TextBlock Text="Expected" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Text="{Binding ValidationDetailExpectedText}"
                                                                           Foreground="#EAF6FF"
                                                                           FontSize="11.5"
                                                                           TextWrapping="Wrap"
                                                                           LineHeight="16"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="2" Style="{StaticResource PremiumSectionCardStyle}">
                                                            <StackPanel>
                                                                <TextBlock Text="Observed" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Text="{Binding ValidationDetailObservedText}"
                                                                           Foreground="#F6D781"
                                                                           FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"
                                                                           LineHeight="16"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <Border Grid.Row="4" Style="{StaticResource PremiumSectionCardStyle}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="8"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="Evidence" Foreground="#F4FAFF" FontSize="13" FontWeight="SemiBold"/>
                                                            <ScrollViewer Grid.Row="2"
                                                                          Style="{StaticResource ModernScrollViewerStyle}"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          HorizontalScrollBarVisibility="Disabled">
                                                                <TextBlock Text="{Binding ValidationDetailEvidenceText}"
                                                                           Foreground="#D6E8F8"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           LineHeight="17"/>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>


                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" Foreground="#EAF6FF" Text="&#xE8D4;"/>
                                    <TextBlock Text="SCL" Foreground="#EAF6FF" FontWeight="SemiBold"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource PremiumWorkspaceHeroStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="SCL Engineering Context" Style="{StaticResource PanelTitleTextStyle}"/>
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="Import an SCL file to compare expected streams with live traffic."
                                                       Style="{StaticResource PanelSubtitleTextStyle}"
                                                       TextWrapping="Wrap"/>
                                            
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding LoadSclCommand}" Style="{StaticResource HeroToolbarButtonStyle}" MinWidth="104" Height="34" Padding="14,0">
                                                <TextBlock Text="Import SCL" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Command="{Binding ClearSclCommand}" Style="{StaticResource ToolbarMutedButtonStyle}" MinWidth="70" Height="34" Padding="12,0" Margin="8,0,0,0">
                                                <TextBlock Text="Clear" FontWeight="SemiBold"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.18*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="0.92*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Semantic stream catalog: filtered by the left SCL Explorer selection -->
                                    <Border Grid.Column="0" Style="{StaticResource PremiumWorkspacePanelStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="0.75*"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="1.25*"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="Engineering streams" Style="{StaticResource PanelTitleTextStyle}"/>
                                                    
                                                </StackPanel>
                                                
                                            </DockPanel>

                                            <DataGrid Grid.Row="2"
                                                      Style="{StaticResource DarkDataGridStyle}"
                                                      ItemsSource="{Binding SclFilteredStreamCatalog}"
                                                      SelectedItem="{Binding SelectedSclStreamCatalog, Mode=TwoWay}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      CanUserSortColumns="False"
                                                      GridLinesVisibility="None"
                                                      RowHeight="{x:Static sys:Double.NaN}"
                                                      MinRowHeight="56"
                                                      RowStyle="{StaticResource EngineeringDataGridRowStyle}"
                                                      CellStyle="{StaticResource EngineeringDataGridCellStyle}"
                                                      FontSize="12"
                                                      EnableRowVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      ScrollViewer.CanContentScroll="True"
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <DataGrid.Resources>
                                                    <Style x:Key="SclCatalogCellTextStyle" TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="TextTrimming" Value="None"/>
                                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                                        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                                                        <Setter Property="LineHeight" Value="16"/>
                                                    </Style>
                                                    <Style x:Key="SclCatalogMetaTextStyle" TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#8FAAC3"/>
                                                        <Setter Property="FontSize" Value="10.5"/>
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="TextTrimming" Value="None"/>
                                                        <Setter Property="LineHeight" Value="15"/>
                                                    </Style>
                                                </DataGrid.Resources>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Type" Width="64">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#0D2A42" BorderBrush="#1F5D89" BorderThickness="1" CornerRadius="8" Padding="7,3" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding Protocol}" Foreground="#9FD8FF" FontSize="11" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Stream / Control" Width="1.45*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#F4FAFF" FontWeight="SemiBold" Style="{StaticResource SclCatalogCellTextStyle}"/>
                                                                    <TextBlock Margin="0,3,0,0" Text="{Binding ControlBlockReference}" Style="{StaticResource SclCatalogMetaTextStyle}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Transport" Width="1.55*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding TransportText}" Style="{StaticResource SclCatalogCellTextStyle}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="DataSet" Width="1.6*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DataSetReference}" Style="{StaticResource SclCatalogCellTextStyle}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Entries" Width="82">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding EntryCountText}" Foreground="#CFE7FF" FontWeight="SemiBold" Style="{StaticResource SclCatalogCellTextStyle}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Live" Width="1.05*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#102438" BorderBrush="#244766" BorderThickness="1" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding LiveStatusText}" Foreground="#EAF6FF" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <DockPanel Grid.Row="4">
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="Live Binding Matrix" Style="{StaticResource PanelTitleTextStyle}"/>
                                                    
                                                </StackPanel>
                                                
                                            </DockPanel>

                                            <DataGrid Grid.Row="6"
                                                      Style="{StaticResource DarkDataGridStyle}"
                                                      ItemsSource="{Binding SclFilteredBindingMatrix}"
                                                      SelectedItem="{Binding SelectedSclBindingMatrixRow, Mode=TwoWay}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      CanUserSortColumns="False"
                                                      GridLinesVisibility="None"
                                                      RowHeight="{x:Static sys:Double.NaN}"
                                                      MinRowHeight="46"
                                                      RowStyle="{StaticResource EngineeringDataGridRowStyle}"
                                                      CellStyle="{StaticResource EngineeringDataGridCellStyle}"
                                                      FontSize="11.5"
                                                      EnableRowVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      ScrollViewer.CanContentScroll="True"
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <DataGrid.Resources>
                                                    <Style x:Key="SclBindingCellTextStyle" TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                                        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                                                        <Setter Property="LineHeight" Value="16"/>
                                                    </Style>
                                                    <Style x:Key="SclBindingMetaTextStyle" TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#8FAAC3"/>
                                                        <Setter Property="FontSize" Value="10.5"/>
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="TextTrimming" Value="None"/>
                                                        <Setter Property="LineHeight" Value="15"/>
                                                    </Style>
                                                </DataGrid.Resources>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Status" Width="132">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <Border Background="{Binding StatusBackgroundBrush}" BorderBrush="{Binding StatusBrush}" BorderThickness="1"
                                                                            CornerRadius="6" Padding="7,4" HorizontalAlignment="Left"
                                                                            ToolTip="{Binding ScoreText}">
                                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="10.5"
                                                                                   FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Expected svID" Width="1.2*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ExpectedName}" Foreground="#F4FAFF"
                                                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                                                   ToolTip="{Binding ExpectedDetailText}"/>
                                                                    </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Observed svID" Width="1.2*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ObservedName}" Foreground="#F6D781"
                                                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                                                   ToolTip="{Binding ObservedDetailText}"/>
                                                                    </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Difference" Width="1.2*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding CompactEvidenceText}"
                                                                           Foreground="#C5DEEF" FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           ToolTip="{Binding EvidenceText}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>

                                    <!-- Selected SCL object detail -->
                                    <Border Grid.Column="2" Style="{StaticResource PremiumInspectorPanelStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Stream details" Style="{StaticResource PanelTitleTextStyle}"/>
                                                <TextBlock Margin="0,4,0,0" Text="{Binding SclSelectedDetailTitle}" Foreground="#F4FAFF" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Margin="0,5,0,0" Text="{Binding SclSelectedDetailSubtitle}" Foreground="#8FAAC3" FontSize="11.5" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Border Grid.Row="2" Background="#0E263A" BorderBrush="#315575"
                                                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                <StackPanel>
                                                    
                                                    <TextBlock Text="{Binding SclSelectedVerdictText}"
                                                               Foreground="#F6D781" FontSize="14" FontWeight="SemiBold"
                                                               Margin="0,0,0,5" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding SclSelectedVerdictDetailText}"
                                                               Foreground="#BCD6E9" FontSize="11.5"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <Expander Grid.Row="4" Header="Technical evidence"
                                                      IsExpanded="False" Foreground="#9FBBD5"
                                                      ToolTip="Full source attributes and original matching evidence are retained">
                                                <StackPanel>
                                                    <Grid Margin="0,8,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource PremiumSectionCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="Expected" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Margin="0,6,0,0" Text="{Binding SclSelectedExpectedText}" Foreground="#EAF6FF" FontSize="12" TextWrapping="Wrap" LineHeight="17"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource PremiumSectionCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="Observed" Foreground="#8FB8D8" FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Margin="0,6,0,0" Text="{Binding SclSelectedObservedText}" Foreground="#F6D781" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="17"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                                    <TextBlock Text="{Binding SclSelectedBindingText}"
                                                               Foreground="#ACCAE0" FontSize="11"
                                                               Margin="3,0,0,5" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Expander>

                                            <Border Grid.Row="6" Style="{StaticResource PremiumSectionCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="10"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <DockPanel>
                                                        <TextBlock Text="DataSet Entry Order" Foreground="#F4FAFF" FontSize="13" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                                        
                                                    </DockPanel>
                                                    <DataGrid Grid.Row="2"
                                                              Style="{StaticResource DarkDataGridStyle}"
                                                              ItemsSource="{Binding SclSelectedEntries}"
                                                              AutoGenerateColumns="False"
                                                              IsReadOnly="True"
                                                              HeadersVisibility="Column"
                                                              CanUserAddRows="False"
                                                              CanUserDeleteRows="False"
                                                              CanUserSortColumns="False"
                                                              GridLinesVisibility="None"
                                                              RowHeight="{x:Static sys:Double.NaN}"
                                                              MinRowHeight="42"
                                                              RowStyle="{StaticResource EngineeringDataGridRowStyle}"
                                                              CellStyle="{StaticResource EngineeringDataGridCellStyle}"
                                                              FontSize="11.5"
                                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <DataGrid.Resources>
                                                            <Style x:Key="SclDetailCellTextStyle" TargetType="TextBlock">
                                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                                <Setter Property="TextTrimming" Value="None"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                                                                <Setter Property="LineHeight" Value="16"/>
                                                            </Style>
                                                        </DataGrid.Resources>
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
                                                            <DataGridTemplateColumn Header="Signal" Width="2.35*">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SclDetailCellTextStyle}" FontFamily="Consolas" FontSize="12" ToolTip="{Binding DisplayName}"/>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTextColumn Header="FC" Binding="{Binding Fc}" Width="0.55*"/>
                                                            <DataGridTextColumn Header="CDC" Binding="{Binding Cdc}" Width="0.75*"/>
                                                            <DataGridTextColumn Header="Type" Binding="{Binding BType}" Width="1.05*"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- P1: avoid showing three enormous empty data-grids before any SCL
                                     document is loaded. Live capture continues independently. -->
                                <Border Grid.Row="2" Background="#0A1A2A"
                                        BorderBrush="#21496A" BorderThickness="1"
                                        CornerRadius="10" Padding="24">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSclProject}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center" MaxWidth="440">
                                        <TextBlock Text="Import SCL to compare streams"
                                                   TextAlignment="Center" FontSize="15"
                                                   FontWeight="SemiBold" Foreground="#EAF6FF"/>
                                        <TextBlock Margin="0,8,0,0"
                                                   Text="SCD, CID, ICD and IID files provide the expected publisher identity and DataSet order."
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   FontSize="11.5" Foreground="#A2C3DE"/>
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="Live capture continues in Analyzer and Diagnostics."
                                                   TextAlignment="Center" FontSize="11"
                                                   Foreground="#88AAC5"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" Foreground="#EAF6FF" Text="&#xE713;"/>
                                    <TextBlock Text="Advanced" Foreground="#EAF6FF" FontWeight="SemiBold"/>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="320"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource PremiumWorkspacePanelStyle}">
                                    <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Border Style="{StaticResource PremiumWorkspaceHeroStyle}" Padding="16,12">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="{Binding AdvancedTargetTitle}"/>
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource PanelSubtitleTextStyle}" Text="{Binding AdvancedTargetSubtitle}" TextWrapping="Wrap"/>
                                                
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,12,0,0"
                                                Style="{StaticResource PremiumSectionCardStyle}">
                                            <TextBlock Text="{Binding AdvancedPrimaryDetailsText}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="17"
                                                       Style="{StaticResource CompactValueTextStyle}"/>
                                        </Border>

                                        <Border Margin="0,10,0,0"
                                                Style="{StaticResource PremiumSectionCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="{Binding AdvancedEvidenceTitle}"/>
                                                <TextBlock Margin="0,7,0,0"
                                                           TextWrapping="Wrap"
                                                           LineHeight="17"
                                                           Style="{StaticResource CompactValueTextStyle}"
                                                           Text="{Binding AdvancedPacketEvidenceText}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,10,0,0"
                                                MinHeight="104"
                                                Style="{StaticResource PremiumSectionCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="{Binding AdvancedDecodedTitle}"/>
                                                <TextBlock Margin="0,7,0,0"
                                                           TextWrapping="Wrap"
                                                           LineHeight="17"
                                                           Style="{StaticResource CompactValueTextStyle}"
                                                           Text="{Binding AdvancedRawValuesText}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,10,0,0"
                                                MinHeight="190"
                                                Style="{StaticResource PremiumSectionCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="{Binding AdvancedEngineeringTitle}"/>
                                                <TextBlock Margin="0,7,0,0"
                                                           TextWrapping="Wrap"
                                                           LineHeight="17"
                                                           Style="{StaticResource CompactValueTextStyle}"
                                                           Text="{Binding AdvancedEngineeringText}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource PremiumInspectorPanelStyle}">
                                    <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="Adapter and estimator"/>
                                        <TextBlock Margin="0,2,0,8" Style="{StaticResource PanelSubtitleTextStyle}" Text="Lab controls and live estimator state"/>

                                        <CheckBox Margin="0,0,0,8"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              FontWeight="SemiBold"
                                              Content="Relax dest"
                                              IsChecked="{Binding RelaxDestinationCheck}"/>

                                        <WrapPanel>
                                            <Button Command="{Binding SwitchToRawCommand}"
                                                    IsEnabled="{Binding CanSwitchCaptureMode}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
                                                        <Setter Property="Background" Value="#12263A"/>
                                                        <Setter Property="BorderBrush" Value="#294864"/>
                                                        <Setter Property="Foreground" Value="#CFE7FF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRawMode}" Value="True">
                                                                <Setter Property="Background" Value="#0E6AC0"/>
                                                                <Setter Property="BorderBrush" Value="#6ED2FF"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="Raw" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                        </WrapPanel>

                                        <Border Margin="0,12,0,0"
                                                Style="{StaticResource PremiumSectionCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="SCL semantic map"/>
                                                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Style="{StaticResource CompactValueTextStyle}" Text="{Binding SclSemanticStatusText}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,10,0,0"
                                                Style="{StaticResource PremiumSectionCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="Estimator detail"/>
                                                <TextBlock Margin="0,6,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding Diagnostics.FrequencyReferenceChannel, StringFormat=Reference: {0}}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding Diagnostics.FrequencyEstimateValid, StringFormat=Valid: {0}}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding Diagnostics.FrequencyCrossingCount, StringFormat=Crossings: {0}}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding Diagnostics.LastMeasuredPeriodMilliseconds, StringFormat=Last period: {0:0.###} ms}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding Diagnostics.FrequencyInputSampleCount, StringFormat=Samples: {0}}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding Diagnostics.TimebaseStatusText, StringFormat=Timebase: {0}}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding Diagnostics.SmpSynchText, StringFormat=SmpSynch: {0}}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding Diagnostics.ExpectedDeltaMicroseconds, StringFormat=Expected delta: {0:0.###} us}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding Diagnostics.CurrentDeltaMicroseconds, StringFormat=Arrival delta: {0:0.###} us}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding Diagnostics.CurrentJitterMicroseconds, StringFormat=Current variation: {0:0.###} us}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding Diagnostics.MaxAbsJitterMicroseconds, StringFormat=Max abs variation: {0:0.###} us}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}">
                                                    <Run Text="Excursions >=300 us: "/>
                                                    <Run Text="{Binding Diagnostics.JitterOver300MicrosecondsCount}"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Style="{StaticResource CompactValueTextStyle}" Text="{Binding Diagnostics.JitterStatusText}"/>
                                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Style="{StaticResource MonoValueTextStyle}" Text="{Binding DebugEstimatorText, StringFormat=Reject: {0}}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,10,0,0"
                                                Style="{StaticResource PremiumSectionCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="Performance"/>
                                                <TextBlock Margin="0,6,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding UiRefreshDurationText}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding UiQueueDepthText}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding ManagedMemoryText}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding Diagnostics.CaptureDropEvidenceText}" TextWrapping="Wrap"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CompactValueTextStyle}" Text="{Binding SkippedRefreshText}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,22,0,0"
                            Padding="18,10"
                            CornerRadius="18"
                            Background="#CC0A1D2E"
                            BorderBrush="#446D9CC9"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE895;"
                                       Foreground="#70D7FF"
                                       FontSize="13"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Preparing selected target view..."
                                       Foreground="#EAF6FF"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>


                <Border Grid.Column="0"
                        Grid.ColumnSpan="5"
                        Grid.Row="2"
                        Padding="10,4"
                        Background="#0B1A2A"
                        BorderBrush="{StaticResource PanelBorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Foreground="#D6E8F8"
                                   Text="{Binding WorkspaceFooterLeftText}"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding WorkspaceFooterRightText}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
