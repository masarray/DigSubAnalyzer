                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource CompactSearchBoxStyle}"
                                         Text="{Binding GoosePublisherFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search by device, message name, network address, application code or published data"/>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="{StaticResource WorkspacePanelGapBelow}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
