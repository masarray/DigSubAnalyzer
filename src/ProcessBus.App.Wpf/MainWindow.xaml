                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                               Text="{Binding DiagnosticFindingsHeaderText}"
                                               Style="{StaticResource PanelTitleTextStyle}"
                                               Margin="0,0,0,8"/>


                                        

                                        <ListView ItemsSource="{Binding CalmDiagnosticEvents}"
                                              SelectedItem="{Binding SelectedDiagnosticEvent, Mode=TwoWay}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Foreground="#EAF6FF"
                                              ItemContainerStyle="{StaticResource EventListItemStyle}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
