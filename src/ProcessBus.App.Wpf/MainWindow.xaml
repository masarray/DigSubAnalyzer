                            <!-- FRAME VIEWER TOOLBAR -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentWorkspaceTabIndex}" Value="6">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Advanced"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#7FBCEB"/>

                                <Button Style="{StaticResource ToolbarGhostButtonStyle}"
                            Command="{Binding ClearCommand}">
                                    <TextBlock Text="Clear Frames"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>

                                <Button Style="{StaticResource ToolbarGhostButtonStyle}"
                            Margin="6,0,0,0"
                            Tag="PCAP Export"
                            Visibility="Collapsed"
                            Click="LockedFeature_Click">
                                    <TextBlock Text="Export PCAP"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>

                                <Button Style="{StaticResource ToolbarGhostButtonStyle}"
                            Margin="6,0,0,0"
                            Tag="Frame Search"
