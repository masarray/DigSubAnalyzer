                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="6"
                                                    CornerRadius="3"
                                                    Margin="0,1,9,1"
                                                    Background="{Binding StatusBrush}"/>
                                            <StackPanel Grid.Column="1">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="{Binding Protocol}"
                                                               Foreground="#8FB8D8"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="#F3FAFF"
                                                               FontSize="12.2"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Foreground="#91AFC8"
                                                           FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding IssueSummaryText}"
                                                           Foreground="#D6E8F8"
                                                           FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="Collapsed"
                                                           ToolTip="{Binding IssueSummaryText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top">
                                                <Border Padding="6,2"
                                                        CornerRadius="7"
                                                        Background="{Binding StatusSoftBrush}"
                                                        BorderBrush="{Binding StatusBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="{Binding StatusBrush}"
                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding LastSeenText}"
                                                           Foreground="#789AB8"
                                                           FontSize="9.5"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

